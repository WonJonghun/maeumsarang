<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%--
  페이지별 헤더 설정
    headerMainYn           : Y/N (N이면 타이틀 표시)
    headerSearchYn         : Y/N (Y이면 검색 상단바 활성)
    headerDateYn           : Y/N (Y이면 달력 활성)
    headerWriteYn          : Y/N (Y이면 글쓰기 버튼 표시)
    headerSelectBox        : 숫자 (0이면 미사용, 1 이상이면 해당 개수만큼 select 생성)
    headerDefaultRangeDays : 숫자 (기본 검색기간)
    headerQrYn             : Y/N (Y이면 QR 버튼 표시)
    headerExcelYn          : Y/N (Y이면 엑셀 다운로드 버튼 표시)
--%>
<c:set var="headerMainYn" value="${empty headerMainYn ? 'Y' : headerMainYn}"/>
<c:set var="headerTitle" value="${empty param.title ? menuAuth.menuName : param.title}"/>
<c:set var="headerSearchYn" value="${empty headerSearchYn ? 'N' : headerSearchYn}"/>
<c:set var="headerDateYn" value="${empty headerDateYn ? 'N' : headerDateYn}"/>
<c:set var="headerWriteYn" value="${empty headerWriteYn ? 'N' : headerWriteYn}"/>
<c:set var="headerSelectBox" value="${empty headerSelectBox ? 0 : headerSelectBox}"/>
<c:set var="headerDefaultRangeDays" value="${empty headerDefaultRangeDays ? 365 : headerDefaultRangeDays}"/>
<c:set var="headerQrYn" value="${empty headerQrYn ? 'N' : headerQrYn}"/>
<c:set var="headerExcelYn" value="${empty headerExcelYn ? 'N' : headerExcelYn}"/>

<header class="topbar"
        data-main-yn="<c:out value='${headerMainYn}'/>"
        data-search-yn="<c:out value='${headerSearchYn}'/>"
        data-date-yn="<c:out value='${headerDateYn}'/>"
        data-write-yn="<c:out value='${headerWriteYn}'/>"
        data-select-box="<c:out value='${headerSelectBox}'/>"
        data-default-range-days="<c:out value='${headerDefaultRangeDays}'/>"
        data-title="<c:out value='${empty headerTitle ? menuAuth.menuName : headerTitle}'/>">

    <div class="topbar-left">
        <c:choose>
            <c:when test="${headerMainYn eq 'Y'}">
                <button type="button" class="icon-button" id="btnMenuToggle" aria-label="메뉴">
                    <i class="bi bi-list"></i>
                </button>
            </c:when>
            <c:otherwise>
                <button type="button" class="menu-top-close" id="btnTopbarBack" aria-label="뒤로가기">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </c:otherwise>
        </c:choose>

        <p id="topbarTitle" class="topbar-title" hidden>
            <c:out value='${empty headerTitle ? menuAuth.menuName : headerTitle}'/>
        </p>

        <div id="topbarSearch" class="topbar-search" hidden>
            <form id="topbarSearchForm" autocomplete="off">
                <div class="topbar-search-row">
                    <button type="button" id="topbarSearchClose" class="icon-button topbar-close-btn" aria-label="닫기">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="topbar-search-field">
                        <input type="search"
                               id="searchKeyword"
                               class="topbar-search-input"
                               placeholder="검색어를 입력해주세요."
                               autocomplete="off"/>

                        <button type="submit" id="topbarSearchSubmit" class="topbar-search-submit" aria-label="검색">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <%--옵션중 하나라도 켜져있으면--%>
                    <c:if test="${headerDateYn eq 'Y' or headerSelectBox gt 0}">
                        <button type="button" id="topbarFilterBtn" class="icon-button topbar-filter-btn" aria-label="검색조건">
                            <i class="bi bi-gear"></i>
                        </button>
                    </c:if>
                </div>

                <%--옵션중 하나라도 켜져있으면--%>
                <c:if test="${headerDateYn eq 'Y' or headerSelectBox gt 0}">
                    <div id="topbarFilterPanel" class="topbar-filter-panel">

                        <%--날짜옵션--%>
                        <c:if test="${headerDateYn eq 'Y'}">
                            <div class="topbar-filter-row">
                                <input type="date" id="searchFromDate" class="topbar-filter-date"/>
                                <span class="topbar-filter-tilde">~</span>
                                <input type="date" id="searchToDate" class="topbar-filter-date"/>
                            </div>
                        </c:if>

                        <%--셀렉트박스옵션--%>
                        <c:if test="${headerSelectBox gt 0}">
                            <c:forEach var="i" begin="1" end="${headerSelectBox}">
                                <div class="topbar-filter-row topbar-filter-select-row" style="margin-top:8px;">
                                    <span id="selectBoxTitle${i}" class="topbar-filter-label"></span>
                                    <select id="selectBox${i}" name="selectBox${i}" class="topbar-filter-date">
                                        <option value="">선택해주세요</option>
                                    </select>
                                </div>
                            </c:forEach>
                        </c:if>

                        <div class="topbar-filter-actions">
                            <button type="button" id="topbarFilterReset" class="topbar-filter-reset">초기화</button>
                            <button type="submit" id="topbarFilterSearch" class="topbar-filter-search">검색</button>
                        </div>
                    </div>
                </c:if>
            </form>
        </div>
    </div>

    <div class="topbar-right">
        <c:if test="${headerQrYn eq 'Y'}">
            <button type="button"
                    class="icon-button topbar-qr-btn"
                    id="btnTopbarQr"
                    aria-label="QR스캔">
                <i class="bi bi-qr-code-scan"></i>
            </button>
        </c:if>

        <c:if test="${headerWriteYn eq 'Y'}">
            <button type="button"
                    class="icon-button topbar-write-btn"
                    id="btnTopbarWrite"
                    aria-label="글쓰기">
                <i class="bi bi-pencil-square"></i>
            </button>
        </c:if>

        <c:if test="${headerExcelYn eq 'Y'}">
            <button type="button"
                    class="icon-button topbar-excel-btn"
                    id="btnTopbarExcel"
                    aria-label="엑셀 다운로드"
                    title="엑셀 다운로드">
                <i class="bi bi-download"></i>
            </button>
        </c:if>

        <!-- searchYn이 N이면 숨김 -->
        <button type="button"
                class="icon-button topbar-search-btn"
                id="btnTopbarSearch"
                aria-label="검색"
                style="display: ${headerSearchYn eq 'Y' ? 'inline-flex' : 'none'};">
            <i class="bi bi-search"></i>
        </button>

        <!-- mainYn이 N이면 숨김 -->
        <div class="topbar-user-text" style="${headerMainYn eq 'N' ? 'display:none;' : ''}">
            <p class="user-name text-blue"><c:out value="${user.icName}"/></p>
            <p class="user-team"><c:out value="${user.ccBuser}"/></p>

            <input type="hidden" id="loginFlag" value="<c:out value='${user.flag}'/>"/>
            <input type="hidden" id="loginIcCode" value="<c:out value='${user.icCode}'/>"/>
            <input type="hidden" id="loginBuser" value="<c:out value='${user.icBuser}'/>"/>
            <input type="hidden" id="loginJikgub" value="<c:out value='${user.icJikgubNm}'/>"/>
            <input type="hidden" id="adminKey" value="<c:out value='${menuAuth.adminKey}'/>"/>
            <input type="hidden" id="menuName" value="<c:out value='${menuAuth.menuName}'/>"/>
            <input type="hidden" id="winCode" value="<c:out value='${empty menuAuth ? "" : menuAuth.winCode}'/>"/>
            <input type="hidden" id="baseKey" value="<c:out value='${empty menuAuth ? "" : menuAuth.baseKey}'/>"/>
        </div>

        <!-- mainYn이 N이면 숨김 -->
        <div class="profile is-topbar" style="${headerMainYn eq 'N' ? 'display:none;' : ''}">
            <span class="profile-check-badge main-badge" data-key="total" style="display:none;">0</span>

            <c:url var="profileImageUrl" value="/attach/profileView.do">
                <c:param name="afNum" value="${user.icCode}"/>
                <c:param name="afSeq" value="1"/>
            </c:url>

            <div class="profile-inner">
                <img src="${profileImageUrl}"
                     alt="프로필 이미지"
                     class="profile-img"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block';"/>
                <i class="bi bi-person-circle profile-icon" style="display:none;"></i>
            </div>
        </div>
    </div>
</header>

<c:if test="${headerMainYn eq 'Y'}">
    <%--메뉴--%>
    <%@ include file="menu.jspf" %>
    <%--프로필 메뉴--%>
    <%@ include file="profileMenu.jspf" %>
</c:if>
<script src="<c:url value='/js/common/header.js'/>"></script>