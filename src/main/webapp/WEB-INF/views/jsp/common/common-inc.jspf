<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<c:if test="${not empty _csrf}">
    <meta name="_csrf" content="${_csrf.token}">
    <meta name="_csrf_header" content="${_csrf.headerName}">
</c:if>

<link rel="manifest" href="<c:url value='/manifest.json'/>">
<meta name="theme-color" content="#ffffff">
<meta content='yes' name='apple-mobile-web-app-capable'/>
<meta content='yes' name='mobile-web-app-capable'/>

<link rel="stylesheet" href="<c:url value='/css/pretendard.css'/>"/>
<link rel="stylesheet" href="<c:url value='/webjars/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css'/>">
<link rel="stylesheet" href="<c:url value='/css/common.css'/>">
<link rel="stylesheet" href="<c:url value='/css/customAlert.css'/>"/>

<script src="<c:url value='/js/common/jquery-3.7.1.min.js'/>"></script>
<script src="<c:url value='/js/common/sw-register.js'/>"></script>
<script src="<c:url value='/js/common/cmUtils.js'/>"></script>
<script src="<c:url value='/js/common/cmAjax.js'/>"></script>
<script src="<c:url value='/js/common/detailDrawer.js'/>"></script>
<script src="<c:url value='/js/common/customAlert.js'/>"></script>

<div id="cmLoadingLayer" class="cm-loading-layer">
    <div class="cm-loading-spinner"></div>
</div>