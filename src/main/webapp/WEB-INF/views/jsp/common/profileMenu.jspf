<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<script type="text/template" id="profileMenuTemplate">
    <div class="profile-drawer">
        <div class="profile-drawer-head">
            <div class="profile-drawer-avatar">
                <c:choose>
                    <c:when test="${not empty user.afContent}">
                        <img class="profile-drawer-img" src="<c:url value='/attach/profileImage.do'/>" alt="프로필 이미지"/>
                    </c:when>
                    <c:otherwise>
                        <i class="bi bi-person-circle profile-icon" style="font-size:44px;"></i>
                    </c:otherwise>
                </c:choose>
            </div>

            <div class="profile-drawer-headtext">
                <div class="profile-drawer-name"><c:out value="${user.icName}"/></div>
                <div class="profile-drawer-sub"><c:out value="${user.icJikgubNm}"/> · <c:out value="${user.ccBuser}"/></div>
                <a href="<c:url value='/profile/myInfo.do'/>" class="profile-myinfo-link">내 정보 관리 <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            </div>

            <a class="profile-drawer-link profile-drawer-logout" href="#" id="btnLogout">
                <img class="profile-drawer-logout-icon" src="<c:url value='/images/logout.png'/>" alt="" aria-hidden="true"/>
                로그아웃
            </a>

            <form id="logoutForm" action="<c:url value='/logout.do'/>" method="post" style="display:none;">
                <input type="hidden" name="<c:out value='${_csrf.parameterName}'/>" value="<c:out value='${_csrf.token}'/>"/>
            </form>
        </div>

        <div class="profile-head-overlap">
            <div class="profile-head-card">
                <%--근무--%>
                <section>
                    <div class="card-header profile-schedule-header">
                        <h3 class="card-title profile-schedule-title"><c:out value="${workWeek}"/> 근무</h3>
                        <a class="btn-text-muted js-move-window" href="#" data-url="/schedule/schedule.do"
                           data-base-key="<c:out value='${user.flag}'/>" data-win-code="w_gunmu">&gt;</a>
                    </div>
                    <div class="scroll-x">
                        <c:forEach var="day" items="${weekDays}">
                            <c:set var="status" value="${day.status}"/>

                            <c:set var="boxClass" value="day-box"/>
                            <c:if test="${day.today}">
                                <c:set var="boxClass" value="${boxClass} day-today"/>
                            </c:if>
                            <c:if test="${status eq 'Off' or status eq '보상' or status eq '연' or status eq '공'
                            or status eq '병' or status eq '육' or status eq '출' or status eq '휴' or status eq '휴일'}">
                                <c:set var="boxClass" value="${boxClass} day-disabled"/>
                            </c:if>

                            <c:set var="labelClass" value="day-label day-label-muted"/>
                            <c:if test="${day.today}">
                                <c:set var="labelClass" value="${labelClass} text-blue"/>
                            </c:if>
                            <c:if test="${day.dayOfWeek == 6}">
                                <c:set var="labelClass" value="${labelClass} day-label-sat"/>
                            </c:if>
                            <c:if test="${day.dayOfWeek == 7}">
                                <c:set var="labelClass" value="${labelClass} day-label-sun"/>
                            </c:if>

                            <c:set var="statusClass" value="day-status text-gray"/>
                            <c:if test="${not empty status}">
                                <c:choose>
                                    <c:when test="${fn:startsWith(status, 'D')}">
                                        <c:set var="statusClass" value="day-status text-black"/>
                                    </c:when>
                                    <c:when test="${fn:startsWith(status, 'E')}">
                                        <c:set var="statusClass" value="day-status text-blue"/>
                                    </c:when>
                                    <c:when test="${fn:startsWith(status, 'N')}">
                                        <c:set var="statusClass" value="day-status text-red"/>
                                    </c:when>
                                    <c:otherwise>
                                        <c:set var="statusClass" value="day-status text-gray"/>
                                    </c:otherwise>
                                </c:choose>
                            </c:if>

                            <div class="${boxClass}">
                                <div class="${labelClass}">
                                    <c:choose>
                                        <c:when test="${day.today}">오늘</c:when>
                                        <c:otherwise><c:out value="${day.dayName}"/></c:otherwise>
                                    </c:choose>
                                </div>
                                <div class="day-date"><c:out value="${day.dayOfMonth}"/></div>
                                <div class="${statusClass}">
                                    <c:choose>
                                        <c:when test="${not empty status}">
                                            <c:out value="${status}"/>
                                        </c:when>
                                        <c:otherwise>-</c:otherwise>
                                    </c:choose>
                                </div>
                            </div>
                        </c:forEach>
                    </div>
                </section>
            </div>
        </div>

        <div class="profile-check-wrap">
            <div class="profile-check-grid" id="profileCheckGrid">
                <a href="<c:url value='/approval/approvalList.do?ccHomeFlag=2&title=결재대기문서'/>" class="profile-check-item is-color bg-1" data-target="main">
                    <span class="profile-check-badge" data-key="approval" style="display:none;">0</span>
                    <i class="bi bi-pencil-square profile-check-ico"></i>
                    <div class="profile-check-txt">결재</div>
                </a>

                <a href="<c:url value='/mail/mailList.do?title=E-Mail'/>" class="profile-check-item is-color bg-2" data-target="main">
                    <span class="profile-check-badge" data-key="mail" style="display:none;">0</span>
                    <i class="bi bi-envelope profile-check-ico"></i>
                    <div class="profile-check-txt">전자메일</div>
                </a>

                <a href="/approval/approvalList.do?ccHomeFlag=1&ccFlag=PL&ccBaseKey=PL&ccWinCode=w_paper_Inout&paperTab=공문"
                   class="profile-check-item is-color bg-3"
                   data-target="main">
                    <span class="profile-check-badge" data-key="official" style="display:none;">0</span>
                    <i class="bi bi-file-earmark-text profile-check-ico"></i>
                    <div class="profile-check-txt">공문도착</div>
                </a>

                <a href="/approval/approvalList.do?ccHomeFlag=1&ccFlag=PL&ccBaseKey=PL&ccWinCode=w_paper_Inout&paperTab=등기"
                   class="profile-check-item is-color bg-3"
                   data-target="main">
                    <span class="profile-check-badge" data-key="post" style="display:none;">0</span>
                    <i class="bi bi-mailbox profile-check-ico"></i>
                    <div class="profile-check-txt">우편</div>
                </a>

                <a href="/approval/approvalList.do?ccHomeFlag=1&ccFlag=PL&ccBaseKey=PL&ccWinCode=w_paper_Inout&paperTab=택배"
                   class="profile-check-item is-color bg-3"
                   data-target="main">
                    <span class="profile-check-badge" data-key="parcel" style="display:none;">0</span>
                    <i class="bi bi-box-seam profile-check-ico"></i>
                    <div class="profile-check-txt">택배</div>
                </a>

                <a href="/approval/approvalList.do?ccHomeFlag=1&title=전체문서" class="profile-check-item is-color bg-6" data-target="main">
                    <span class="profile-check-badge" data-key="coop" style="display:none;">0</span>
                    <i class="bi bi-people profile-check-ico"></i>
                    <div class="profile-check-txt">협조문서</div>
                </a>
            </div>
        </div>

        <div class="profile-check-wrap">
            <%--휴가 현황--%>
            <section class="card margin-bottom-2 border-check">
                <div class="card-header margin-bottom-2">
                    <h3 class="card-title font-size-12">휴가 현황</h3>
                </div>
                <div class="vac-grid">
                    <div class="vac-item">
                        <p class="vac-label">총 연차</p>
                        <p class="vac-value vac-value-total" id="vacTotal">-</p>
                    </div>
                    <div class="vac-item">
                        <p class="vac-label">사용</p>
                        <p class="vac-value vac-value-used" id="vacUsed">-</p>
                    </div>
                    <div class="vac-item">
                        <p class="vac-label">잔여</p>
                        <p class="vac-value vac-value-left" id="vacLeft">-</p>
                    </div>
                </div>
                <%--<button type="button" class="btn-gray-full">휴가 신청하기</button>--%>
            </section>
        </div>

        <div class="profile-check-wrap padding-top-6">
            <%--출퇴근 현황--%>
            <section class="card margin-bottom-2 border-check">
                <div class="card-header margin-bottom-2">
                    <h3 class="card-title font-size-12">금일 출퇴근 현황</h3>
                </div>

                <div class="commute-stat">
                    <div class="commute-box">
                        <div class="commute-col">
                            <div class="commute-label">출근 시간</div>
                            <div class="commute-value" id="commuteInTime">-</div>
                        </div>

                        <div class="commute-mid" aria-hidden="true">
                            <i class="bi bi-arrow-right"></i>
                        </div>

                        <div class="commute-col">
                            <div class="commute-label">퇴근 시간</div>
                            <div class="commute-value" id="commuteOutTime">-</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

    </div>
</script>

<script src="<c:url value='/js/common/profileMenu.js'/>"></script>