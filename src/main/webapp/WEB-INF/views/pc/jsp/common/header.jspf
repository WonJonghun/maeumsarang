<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<header class="pc-topbar">
    <div class="pc-topbar-left">
        <a class="pc-brand" href="<c:url value='/pc/main.do'/>" aria-label="마음사랑병원 인트라넷 홈">
            <img src="<c:url value='/images/mainLogo.png'/>" alt="마음사랑병원" class="pc-brand-image">
        </a>
    </div>

    <div class="pc-topbar-right">
    <div class="pc-user">
        <c:url var="pcProfileImageUrl" value="/attach/profileView.do">
            <c:param name="afNum" value="${user.icCode}"/>
            <c:param name="afSeq" value="1"/>
        </c:url>
        <button type="button" id="pcProfileToggle" class="pc-profile-trigger" aria-expanded="false"
                aria-controls="pcProfileMenu" aria-label="내 프로필 메뉴">
        <span class="profile pc-profile" aria-label="프로필 사진">
            <img id="pcProfileImage" src="<c:out value='${pcProfileImageUrl}'/>"
                 data-fallback-src="<c:url value='/images/emptyUser.png'/>" alt="" class="profile-img">
        </span>
        <span class="topbar-user-text">
            <span class="user-name"><c:out value="${user.icName}"/></span>
            <span class="user-team"><c:out value="${user.ccBuser}"/></span>
        </span>
        <i class="bi bi-chevron-down pc-profile-chevron" aria-hidden="true"></i>
        </button>
        <div id="pcProfileMenu" class="pc-profile-menu" hidden>
            <div class="pc-profile-menu-head">
                <span class="profile pc-profile pc-profile-menu-avatar">
                    <img id="pcProfileMenuImage" src="<c:out value='${pcProfileImageUrl}'/>"
                         data-fallback-src="<c:url value='/images/emptyUser.png'/>" alt="" class="profile-img">
                </span>
                <div class="topbar-user-text">
                    <p class="user-name"><c:out value="${user.icName}"/></p>
                    <p class="user-team"><c:out value="${user.ccBuser}"/><span class="pc-profile-code"><c:out value="${user.icCode}"/></span></p>
                </div>
            </div>
            <form action="<c:url value='/logout.do'/>" method="post">
                <input type="hidden" name="loginType" value="pc">
                <input type="hidden" name="<c:out value='${_csrf.parameterName}'/>" value="<c:out value='${_csrf.token}'/>">
                <button type="submit" class="pc-profile-logout">
                    <i class="bi bi-power" aria-hidden="true"></i>
                    로그아웃
                </button>
            </form>
        </div>
    </div>
        <span class="pc-topbar-divider" aria-hidden="true"></span>
        <div class="pc-topbar-actions" aria-label="업무 도구">
            <button type="button" id="pcNotificationButton" class="pc-topbar-action" aria-label="알림">
                <i class="bi bi-bell" aria-hidden="true"></i>
            </button>
            <button type="button" id="pcOrganizationButton" class="pc-topbar-action" aria-label="연락처">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
            </button>
        </div>
        <span class="pc-topbar-divider" aria-hidden="true"></span>
        <div class="pc-zoom-controls" role="group" aria-label="화면 배율">
            <button type="button" id="pcZoomIn" class="pc-topbar-action" aria-label="화면 확대">
                <i class="bi bi-zoom-in" aria-hidden="true"></i>
            </button>
            <output id="pcZoomValue" class="pc-zoom-value" aria-live="polite" aria-label="현재 배율">100%</output>
            <button type="button" id="pcZoomOut" class="pc-topbar-action" aria-label="화면 축소">
                <i class="bi bi-zoom-out" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</header>
