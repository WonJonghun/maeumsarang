<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>

<aside id="pcSidebar" class="pc-sidebar" aria-label="업무 메뉴"
       data-menu-url="<c:url value='/menu/tree.do'/>">
        <div class="pc-menu-tools">
            <button type="button" id="pcMenuPin" aria-label="메뉴 펼침 상태 고정" title="메뉴 고정" aria-pressed="false">
                <i class="bi bi-pin-angle" aria-hidden="true"></i>
            </button>
            <button type="button" id="pcMenuTab" aria-label="전체 메뉴" title="전체 메뉴" aria-controls="pcMenuContents" aria-pressed="true">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <button type="button" id="pcFavoritesTab" aria-label="즐겨찾기" title="즐겨찾기" aria-controls="pcFavoritesPanel" aria-pressed="false">
                <i class="bi bi-star" aria-hidden="true"></i>
            </button>
        </div>
    <nav class="pc-menu-rail" aria-label="대메뉴">
        <ul id="pcMenuRoots" class="pc-menu-roots"></ul>
    </nav>
    <section id="pcMenuPanelContainer" class="pc-menu-panel" aria-labelledby="pcMenuTitle" aria-hidden="true" inert>
        <div class="pc-menu-heading">
            <h2 id="pcMenuTitle">업무 메뉴</h2>
        </div>
        <div id="pcMenuContents" class="pc-menu-contents">
            <nav id="pcMenuTree" class="pc-menu-tree" aria-labelledby="pcMenuTitle" aria-busy="true"></nav>
            <p id="pcMenuStatus" class="pc-menu-status" role="status">메뉴를 불러오는 중입니다.</p>
            <button type="button" id="pcMenuRetry" class="pc-menu-retry" hidden>다시 불러오기</button>
        </div>
        <div id="pcFavoritesPanel" class="pc-favorites-panel" hidden>
            <p>등록된 즐겨찾기가 없습니다.</p>
        </div>
    </section>
</aside>
