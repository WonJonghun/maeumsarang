<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mshintra.main.mapper.MainMapper">

    <select id="selectMainBirthDayList" resultType="com.example.mshintra.main.dto.MainBirthDayDto" statementType="CALLABLE">
        { call dbo.Intranet_Main_BirthDay(#{searchDate}, '', '') }
    </select>

    <select id="selectMainMealList" resultType="com.example.mshintra.main.dto.MainMealDto">
        SELECT Fm_Date,
               Fm_Flag,
               Fm_type,
               Fm_Code,
               Fm_GuFlag,
               Re_name,
               Fm_Cnt1,
               Fm_Cnt2,
               Fm_Cnt3,
               Fm_Kal,
               Fm_pro,
               Sflag,
               Flag
        FROM dbo.GetRecipeList(#{searchDate}, 'A')
        ORDER BY Fm_Flag, Sflag
    </select>
</mapper>